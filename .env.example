# Chatbox AI API Key
# 在 chatboxai.app 登录后 → Dashboard → 复制 License Key
CHATBOX_API_KEY=your_license_key_here

# Server Port (optional, default: 3001)
PORT=3001

# Exhibition admin (server-only). Use long, unique values in your environment.
EXHIBITION_ADMIN_PASSWORD=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
