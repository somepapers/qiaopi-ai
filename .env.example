# DeepSeek API Key
# 在 platform.deepseek.com 的 API Keys 页面创建密钥
DEEPSEEK_API_KEY=your_api_key_here

# Server Port (optional, default: 3001)
PORT=3001

# Exhibition admin (server-only). Use long, unique values in your environment.
EXHIBITION_ADMIN_PASSWORD=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
